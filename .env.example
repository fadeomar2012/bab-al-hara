DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/bab_al_hara?schema=public"

# Admin dashboard — internal staff login. Never commit real values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-locally"
ADMIN_NAME="Bab Al Hara Admin"
ADMIN_SESSION_SECRET="replace-with-random-secret"

# Public base URL used for QR codes on invoices/packing slips.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary — server-side image uploads for products & banners.
# API secret is server-only; never expose it to the client. Placeholders only.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="bab-al-hara/dev"